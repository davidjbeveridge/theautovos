{
  // Cloudflare Workers Static Assets: static hosting plus the single inquiry endpoint.
  "name": "auto-vos-site",
  "account_id": "488e0d64df5803c663dd8c6e5c0c2049",
  "main": "server/worker.mjs",
  "compatibility_date": "2026-10-02",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "theautovos.com/*", "zone_id": "28cdcb9a1b23fe98185597ecdb4ef4d0" },
    { "pattern": "www.theautovos.com/*", "zone_id": "28cdcb9a1b23fe98185597ecdb4ef4d0" }
  ],
  "build": { "command": "node scripts/build-production.mjs" },
  "assets": { "directory": "./dist-production", "binding": "ASSETS", "run_worker_first": true, "not_found_handling": "404-page" },
  "ratelimits": [{ "name": "INQUIRY_RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }],
  "send_email": [{ "name": "INQUIRY_EMAIL", "allowed_destination_addresses": ["theautovos@gmail.com"] }],
  "vars": {
    "SITE_ORIGIN": "https://theautovos.com",
    "SHOP_URL": "https://shop.theautovos.com/",
    "MAIL_PROVIDER": "cloudflare",
    "MAIL_FROM": "Auto Vos <inquiries@theautovos.com>",
    "TURNSTILE_SITE_KEY": "0x4AAAAAAFfs9M_kszjJv4lZ"
  },
  "observability": { "enabled": false }
}
