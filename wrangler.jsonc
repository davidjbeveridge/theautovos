{
  // Cloudflare Workers Static Assets: static hosting plus the single inquiry endpoint.
  "name": "auto-vos-site",
  "main": "server/worker.mjs",
  "compatibility_date": "2026-10-02",
  "workers_dev": false,
  "assets": { "directory": "./dist-production", "binding": "ASSETS", "run_worker_first": ["/api/*"], "not_found_handling": "404-page" },
  "ratelimits": [{ "name": "INQUIRY_RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }],
  "vars": { "SITE_ORIGIN": "https://www.theautovos.com" },
  "observability": { "enabled": false }
}
